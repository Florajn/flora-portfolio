    "gameplayModules": [
      {
        "id": "koy7kts",
        "name": "驾驶房车 ",
        "intro": "核心移动与旅途体验\n玩家驾驶房车穿越不同主题场景，在公路上自由行驶，寻找探索地点，体验从一个目的地前往另一个目的地的过程。",
        "rules": "房车只能在驾驶状态下进行车辆控制。\n玩家可以自由控制行驶速度和方向。\n到达合适位置后可以停车并下车。\n玩家可以重新进入驾驶位，继续旅程。\n不同章节拥有独立的道路与自然环境。",
        "controls": "W：加速\nS：刹车 / 倒车\nA / D：左右转向\nE：上下车交互\n鼠标：调整驾驶视角",
        "feedback": "房车根据输入产生对应的行驶、转向和制动反馈。\n车轮随车辆移动旋转，悬挂随地形产生动态变化。\n驾驶视角随车辆状态切换。\n停车后可以进入场景探索状态。",
        "flow": "",
        "media": []
      },
      {
        "id": "6k5k6zg",
        "name": "场景探索系统",
        "intro": "玩家下车后进入第三人称探索模式，可以在场景中行走、奔跑和跳跃，探索不同区域，与环境中的物品和 NPC 进行互动，逐步发现各章节的故事内容。",
        "rules": "玩家可以在允许探索的区域内自由移动。\n部分物品和 NPC 支持近距离交互。\n特定剧情需要到达指定地点才能触发。\n探索过程中可以发现可采集资源和隐藏的场景细节。",
        "controls": "WASD：角色移动\nShift：奔跑\nSpace：跳跃\n鼠标：调整第三人称视角\nE：交互",
        "feedback": "角色根据输入切换站立、行走、奔跑和跳跃动画。\n靠近可交互对象时提供交互提示。\n到达关键地点后触发对应章节事件。\n探索过程带来场景发现与沉浸式体验。",
        "flow": "",
        "media": []
      },
      {
        "id": "ti64z2v",
        "name": "NPC 互动与 AI 对话系统",
        "intro": "玩家在不同章节遇见具有独立背景故事的 NPC，通过固定剧情对话了解人物与环境，再进入 AI 自由对话模式，自主输入问题，与 NPC 进行更加开放的交流。",
        "rules": "走近 NPC 后按 E 键触发交谈。\n初次相遇播放预设剧情台词。\n完成固定对话后可以进入 AI 自由聊天。\nNPC 根据自身角色背景和当前章节语境进行回应。\n章节关键事件通过指定 NPC 交互推进。",
        "controls": "E：开始交谈\n鼠标：选择对话交互区域\n键盘：输入聊天内容\n发送按钮：提交对话\n退出按钮：结束聊天并恢复角色控制",
        "feedback": "NPC 根据剧情节点触发对应台词。\nAI 根据玩家输入生成自然语言回复。\n不同 NPC 拥有独立的人物设定与交流内容。\n对话推动章节任务，并解锁相关旅行纪念内容。",
        "flow": "",
        "media": []
      },
      {
        "id": "jffamus",
        "name": "旅行摄影与相册系统",
        "intro": "玩家可以在探索过程中随时开启拍照功能，自由选择场景和拍摄角度，记录旅途中的风景与人物。拍摄完成后，照片可以保存至旅行相册，作为旅途纪念。",
        "rules": "按 P 键进入拍照模式。\n玩家可以自由选择拍摄时机与角度。\n拍摄后可以保存照片。\n已保存照片进入旅行相册。\n相册提供照片缩略图和放大预览功能。",
        "controls": "P：开启拍照\n鼠标：调整拍摄视角\n拍摄按钮：记录当前画面\n保存按钮：保存照片\n相册入口：查看已保存照片",
        "feedback": "实时呈现当前拍摄画面。\n拍摄成功后生成照片记录。\n相册自动更新已保存的图片。\n特定章节照片可以用于完成对应旅行任务。",
        "flow": "",
        "media": []
      },
      {
        "id": "kfasr49",
        "name": "资源采集与烹饪系统",
        "intro": "玩家可以在场景中寻找并采集食材，将收集到的资源存入背包。返回房车后，可以通过厨房食谱系统选择料理，消耗对应食材完成制作。",
        "rules": "靠近可采集资源后按 E 键采集。\n采集物品进入玩家背包。\n通过 Q 键打开房车厨房食谱。\n选择已有食材支持的料理进行制作。\n制作成功后扣除对应食材，料理进入背包。",
        "controls": "E：采集食材\nQ：打开厨房\n鼠标：选择食谱\n制作按钮：开始烹饪\n背包入口：查看获得的物品",
        "feedback": "采集成功后更新背包数量。\n食材不足时无法制作对应料理。\n制作成功后显示料理结果。\n成品自动存入背包，实现资源收集到料理制作的完整循环。",
        "flow": "",
        "media": []
      },
      {
        "id": "14vln1j",
        "name": "背包与旅行收藏系统",
        "intro": "玩家通过统一背包系统管理旅途中的物品。背包采用20格容量设计，并与房车冰箱、储物柜共享统一的容器管理逻辑。同时，玩家可以通过章节探索获得专属纪念品，记录每一段旅程。",
        "rules": "玩家背包容量为20格。\n房车冰箱与储物柜使用独立容器。\n玩家可以在不同容器之间管理物品。\n章节纪念品通过完成对应剧情任务获得。\n旅行日记根据章节进度逐步解锁。",
        "controls": "背包入口：打开物品栏\n鼠标：选择物品\n拖动 / 点击：进行物品管理（以实际实现的交互为准）\nE：与指定容器交互",
        "feedback": "物品变化实时更新背包显示。\n容器之间共享统一物品管理逻辑。\n章节完成后获得对应纪念品。\n旅行日记逐步记录玩家的旅途经历。",
        "flow": "",
        "media": []
      }
